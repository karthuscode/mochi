{
  "name": "mochi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "pnpm desktop:dev",
    "dev:web": "pnpm --filter @mochi/desktop dev",
    "desktop:dev": "pnpm --filter @mochi/desktop tauri dev",
    "build": "pnpm typecheck && pnpm --filter @mochi/desktop build",
    "desktop:build": "pnpm --filter @mochi/desktop tauri build --bundles app",
    "test": "pnpm test:frontend && pnpm test:rust",
    "test:frontend": "vitest run",
    "test:rust": "pnpm prepare:native && cargo test --workspace --locked",
    "lint": "pnpm lint:frontend && pnpm lint:rust",
    "lint:frontend": "eslint . --max-warnings 0",
    "lint:rust": "pnpm prepare:native && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "typecheck": "pnpm -r typecheck",
    "check:rust": "pnpm prepare:native && cargo check --workspace --all-targets --locked",
    "prepare:native": "cargo build -p mochi-hook --locked && cargo build -p mochi-hook --release --locked"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
