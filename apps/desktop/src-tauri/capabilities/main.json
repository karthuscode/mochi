{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Narrow local consent, session, sanitized analysis preview and self-check commands. No arbitrary filesystem, shell, credential read or network access.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-local-status",
    "allow-list-projects",
    "allow-approve-project",
    "allow-preview-connection",
    "allow-apply-connection",
    "allow-set-tracking",
    "allow-pause-all-capture",
    "allow-list-sessions",
    "allow-session-detail",
    "allow-finish-session",
    "allow-delete-session",
    "allow-delete-project",
    "allow-analysis-status",
    "allow-analysis-permission",
    "allow-store-api-key",
    "allow-delete-api-key",
    "allow-preview-analysis",
    "allow-approve-analysis",
    "allow-cancel-analysis",
    "allow-learning-document",
    "allow-submit-selfcheck",
    "allow-reveal-selfcheck"
  ]
}
